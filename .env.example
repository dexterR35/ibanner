# Per-machine settings for the optional local AI service.
# Copy to .env (gitignored) and uncomment what you need. Shell variables win over this file.
# npm run dev / ai:doctor / qwen:* read it; restart npm run dev after changes.

# Device for every model: auto (default), cpu, cuda or cuda:N.
# auto picks the largest GPU that the installed PyTorch build supports, else the CPU.
# BANNERFLOW_DEVICE=auto

# Per-model overrides (same values as above).
# BANNERFLOW_QWEN_DEVICE=auto
# BANNERFLOW_FLORENCE_DEVICE=auto
# BANNERFLOW_SAM3_DEVICE=auto
# BANNERFLOW_TOOLS_DEVICE=auto

# Qwen checkpoint from services/vision/qwen-models.json. List: npm run qwen:download -- --list
# Sole planner: Qwen/Qwen3-VL-8B-Instruct. Removed smaller-model variants.
# BANNERFLOW_QWEN_VARIANT=qwen3-vl-8b
# Precision: auto (full precision on >=24 GB GPU, NF4 on smaller supported GPUs), nf4, bf16.
# BANNERFLOW_QWEN_PRECISION=auto

# Where Hugging Face model weights are stored (default: ~/.cache/huggingface).
# Useful when the system drive is small, e.g. HF_HOME=D:\models\huggingface
# HF_HOME=

# PyTorch build used by npm run ai:setup when auto-detection is not wanted:
# cu130, cu128, cu126, cu132, cpu, rocm7.2 (Linux) or pypi (macOS).
# BANNERFLOW_TORCH_CHANNEL=

# Python interpreter for the services (default: .venv-sam3, created by npm run ai:setup).
# BANNERFLOW_PYTHON=
